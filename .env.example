# Site
NEXT_PUBLIC_SITE_URL=https://example.com

# Content preview
# "true" shows draft or pending content with a PREVIEW badge. Never enable in production.
CONTENT_PREVIEW=false
# "true" enables /admin/verification (internal checklist). Keep false in production
# until real authentication protects it.
ENABLE_INTERNAL_PAGES=false

# Inquiry storage (Supabase), server-side only
SUPABASE_URL=
# Secret. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
INQUIRY_RETENTION_DAYS=90

# Notifications (Resend), server-side only
RESEND_API_KEY=
# Inbox that receives new requests
INQUIRY_NOTIFY_EMAIL=
# Verified sender address on your domain
INQUIRY_FROM_EMAIL=

# Spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
